
# Copie pra .env e ajuste se precisar. Sem .env, os defaults do db.js/server.js já funcionam.
PORT=3000
DB_PATH=./data/mase.db

# Client ID do Google OAuth (tipo "Web application"), criado em
# https://console.cloud.google.com/apis/credentials — mesmo Client ID
# que vai no front, em script.js (GOOGLE_CLIENT_ID). Sem isso, POST
# /usuarios/entrar-google responde 500.
GOOGLE_CLIENT_ID=131029563564-25fb10maaduh4ki6nu8pspqohp8kg49c.apps.googleusercontent.com

# Pasta onde ficam as fotos servidas em /img/... (perfil, capa, serviço).
# Aponta pro mesmo lugar que fotoPerfilPrestador/fotoCapaPrestador/fotoServicoPrestador
# já esperam no frontend (/mase/img/prestadores/...).
IMG_DIR=./public/img
